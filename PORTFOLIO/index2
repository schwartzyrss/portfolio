<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Princess Zyra Joyce U. Lagmay — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --green-50: #f0faf4; --green-100: #d4f0de; --green-200: #a8e1be;
    --green-400: #4caf78; --green-500: #2e8b57; --green-600: #1e6b3f;
    --green-700: #164f2e; --green-800: #0e3520; --green-900: #071a10;
    --cream: #faf8f3; --cream-dark: #f0ede4; --text-dark: #1a2e1f;
    --text-mid: #3a5244; --text-muted: #6b8c75; --gold: #c8a84b;
    --gold-light: #f0e0a0; --white: #ffffff;
  }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream); color: var(--text-dark); overflow-x: hidden;
  }
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: var(--cream-dark); }
  ::-webkit-scrollbar-thumb { background: var(--green-400); border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--green-600); }

  nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    padding: 1.2rem 4rem; display: flex; align-items: center; justify-content: space-between;
    background: rgba(240, 237, 228, 0.92); backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(78, 175, 120, 0.15); transition: box-shadow 0.3s;
  }
  nav.scrolled { box-shadow: 0 4px 32px rgba(30, 107, 63, 0.12); }
  .nav-logo {
    font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--green-700);
    letter-spacing: 0.03em; text-decoration: none; font-weight: 600;
  }
  .nav-links { display: flex; gap: 2.4rem; list-style: none; }
  .nav-links a {
    font-size: 0.82rem; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--text-mid); text-decoration: none;
    position: relative; transition: color 0.2s;
  }
  .nav-links a::after {
    content: ''; position: absolute; bottom: -3px; left: 0;
    width: 0; height: 1.5px; background: var(--green-500); transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--green-600); }
  .nav-links a:hover::after { width: 100%; }
  .menu-toggle {
    display: none; background: none; border: none;
    font-size: 1.5rem; cursor: pointer; color: var(--green-700);
  }

  .hero {
    min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr;
    align-items: center; padding: 8rem 4rem 4rem;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; top: -20%; right: -10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(76,175,120,0.12) 0%, transparent 70%);
    border-radius: 50%;
  }
  .hero-text { z-index: 1; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--green-600);
    background: var(--green-100); padding: 6px 16px; border-radius: 100px;
    margin-bottom: 1.8rem; border: 1px solid var(--green-200);
    opacity: 0; animation: fadeUp 0.6s 0.2s forwards;
  }
  .hero-tag span { width: 6px; height: 6px; background: var(--green-500); border-radius: 50%; }
  .hero-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem); line-height: 1.1;
    color: var(--green-800); margin-bottom: 0.3rem;
    opacity: 0; animation: fadeUp 0.6s 0.35s forwards;
  }
  .hero-name em { color: var(--green-500); font-style: italic; }
  .hero-role {
    font-size: 1.05rem; font-weight: 300; color: var(--text-muted);
    margin-bottom: 1.8rem; letter-spacing: 0.02em;
    opacity: 0; animation: fadeUp 0.6s 0.5s forwards;
  }
  .hero-desc {
    font-size: 0.95rem; line-height: 1.8; color: var(--text-mid);
    max-width: 440px; margin-bottom: 2.5rem;
    opacity: 0; animation: fadeUp 0.6s 0.65s forwards;
  }
  .hero-btns {
    display: flex; gap: 1rem; flex-wrap: wrap;
    opacity: 0; animation: fadeUp 0.6s 0.8s forwards;
  }
  .btn-primary {
    padding: 0.75rem 2rem; background: var(--green-600); color: #fff;
    border: none; border-radius: 100px; font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem; font-weight: 500; letter-spacing: 0.04em;
    cursor: pointer; transition: background 0.2s, transform 0.2s;
    text-decoration: none; display: inline-block;
  }
  .btn-primary:hover { background: var(--green-700); transform: translateY(-2px); }
  .btn-outline {
    padding: 0.75rem 2rem; background: transparent; color: var(--green-700);
    border: 1.5px solid var(--green-400); border-radius: 100px;
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 500;
    letter-spacing: 0.04em; cursor: pointer; transition: all 0.2s;
    text-decoration: none; display: inline-block;
  }
  .btn-outline:hover { background: var(--green-100); transform: translateY(-2px); }
  .hero-visual {
    display: flex; justify-content: center; align-items: center;
    z-index: 1; opacity: 0; animation: fadeIn 0.8s 0.6s forwards;
  }
  .hero-avatar-wrap { position: relative; width: 320px; height: 380px; }
  .hero-avatar-bg {
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 280px; height: 340px;
    background: linear-gradient(135deg, var(--green-200), var(--green-100));
    border-radius: 60% 60% 50% 50%;
  }
  .hero-avatar-initials {
    position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
    width: 260px; height: 310px;
    background: linear-gradient(170deg, var(--green-400) 0%, var(--green-700) 100%);
    border-radius: 55% 55% 45% 45%;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 4px;
  }
  .hero-avatar-initials .initials-text {
    font-family: 'Playfair Display', serif; font-size: 5rem;
    color: rgba(255,255,255,0.9); font-style: italic; line-height: 1;
  }
  .hero-avatar-initials .initials-sub {
    font-size: 0.7rem; color: rgba(255,255,255,0.6);
    letter-spacing: 0.15em; text-transform: uppercase;
  }
  .hero-float-badge {
    position: absolute; background: var(--white); border-radius: 12px;
    padding: 10px 14px; box-shadow: 0 8px 24px rgba(30,107,63,0.12);
    border: 1px solid var(--green-100); font-size: 0.78rem; font-weight: 500;
    color: var(--green-700); display: flex; align-items: center; gap: 7px;
  }
  .hero-float-badge .badge-dot { width: 8px; height: 8px; background: var(--green-400); border-radius: 50%; flex-shrink: 0; }
  .badge-top { top: 0; right: -10px; animation: float1 3s ease-in-out infinite; }
  .badge-bottom { bottom: 40px; left: -20px; animation: float2 3.5s ease-in-out infinite; }
  .scroll-hint {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); opacity: 0; animation: fadeIn 0.6s 1.2s forwards;
  }
  .scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, var(--green-400), transparent); animation: scrollLine 1.5s ease-in-out infinite; }

  section { padding: 6rem 4rem; }
  .section-label {
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--green-500); margin-bottom: 0.6rem;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--green-800);
    margin-bottom: 1rem; line-height: 1.2;
  }
  .section-divider {
    width: 48px; height: 2px; background: var(--green-400);
    border-radius: 2px; margin-bottom: 3rem;
  }

  .about { background: var(--white); }
  .about-inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 5rem; align-items: start;
  }
  .about-info-box {
    background: var(--green-50); border: 1px solid var(--green-200);
    border-radius: 20px; padding: 2rem;
  }
  .about-info-row { display: flex; gap: 12px; margin-bottom: 1.2rem; align-items: flex-start; }
  .about-info-row:last-child { margin-bottom: 0; }
  .info-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--green-100); display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 1rem;
  }
  .info-label { font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 2px; }
  .info-value { font-size: 0.9rem; color: var(--text-dark); font-weight: 500; }
  .about-text p { font-size: 0.95rem; line-height: 1.85; color: var(--text-mid); margin-bottom: 1.2rem; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.5rem; }
  .chip {
    font-size: 0.78rem; font-weight: 500; color: var(--green-700);
    background: var(--green-100); border: 1px solid var(--green-200);
    padding: 5px 14px; border-radius: 100px; transition: all 0.2s; cursor: default;
  }
  .chip:hover { background: var(--green-200); transform: translateY(-1px); }

  .experience { background: var(--cream); }
  .exp-inner { max-width: 900px; margin: 0 auto; }
  .timeline { position: relative; padding-left: 2.5rem; }
  .timeline::before {
    content: ''; position: absolute; left: 0; top: 8px;
    width: 2px; height: calc(100% - 8px);
    background: linear-gradient(to bottom, var(--green-400), transparent);
  }
  .tl-item {
    position: relative; margin-bottom: 3rem;
    opacity: 0; transform: translateX(-20px);
    transition: opacity 0.5s, transform 0.5s;
  }
  .tl-item.visible { opacity: 1; transform: translateX(0); }
  .tl-dot {
    position: absolute; left: -2.95rem; top: 4px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--green-400); border: 3px solid var(--cream);
    box-shadow: 0 0 0 2px var(--green-400);
  }
  .tl-date { font-size: 0.75rem; font-weight: 500; color: var(--green-500); letter-spacing: 0.06em; margin-bottom: 0.4rem; }
  .tl-card {
    background: var(--white); border-radius: 16px; padding: 1.5rem 1.8rem;
    border: 1px solid var(--green-100); transition: box-shadow 0.3s, transform 0.3s;
  }
  .tl-card:hover { box-shadow: 0 12px 40px rgba(30,107,63,0.08); transform: translateY(-3px); }
  .tl-role { font-size: 1rem; font-weight: 500; color: var(--green-700); margin-bottom: 0.2rem; }
  .tl-org { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem; font-style: italic; }
  .tl-bullets { list-style: none; }
  .tl-bullets li {
    font-size: 0.88rem; line-height: 1.7; color: var(--text-mid);
    padding-left: 1.1rem; position: relative; margin-bottom: 0.4rem;
  }
  .tl-bullets li::before {
    content: ''; position: absolute; left: 0; top: 0.65em;
    width: 5px; height: 5px; background: var(--green-400); border-radius: 50%;
  }

  .projects { background: var(--white); }
  .projects-inner { max-width: 1200px; margin: 0 auto; }
  .project-section {
    margin-bottom: 4rem; border: 1px solid var(--green-200);
    border-radius: 24px; overflow: hidden; background: var(--white);
    transition: box-shadow 0.3s;
  }
  .project-section:hover { box-shadow: 0 12px 40px rgba(30,107,63,0.1); }
  .project-header {
    background: linear-gradient(135deg, var(--green-50), var(--green-100));
    padding: 1.5rem 2rem; cursor: pointer; display: flex;
    align-items: center; justify-content: space-between;
    transition: background 0.3s;
  }
  .project-header:hover { background: linear-gradient(135deg, var(--green-100), var(--green-200)); }
  .project-header-left { display: flex; align-items: center; gap: 1rem; }
  .project-icon { font-size: 1.8rem; }
  .project-title-text { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--green-800); font-weight: 600; }
  .project-subtitle { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
  .project-toggle { font-size: 1.5rem; color: var(--green-600); transition: transform 0.3s; font-weight: 300; }
  .project-toggle.active { transform: rotate(180deg); }
  .project-content { max-height: 0; overflow: hidden; transition: max-height 0.5s ease; background: var(--white); }
  .project-content.open { max-height: 3000px; }
  .project-body { padding: 2rem; }
  .project-desc { font-size: 0.95rem; color: var(--text-mid); line-height: 1.7; margin-bottom: 1.5rem; max-width: 700px; }

  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: PHOTO GALLERY STYLES START HERE                    */
  /* ═══════════════════════════════════════════════════════════ */
  .gallery-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;
  }
  .gallery-item {
    position: relative; border-radius: 16px; overflow: hidden;
    background: var(--green-50); border: 2px dashed var(--green-200);
    aspect-ratio: 4/3; display: flex; flex-direction: column;
    align-items: center; justify-content: center; transition: all 0.3s;
  }
  .gallery-item:hover { border-color: var(--green-400); transform: translateY(-4px); box-shadow: 0 8px 24px rgba(30,107,63,0.1); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; }
  .gallery-placeholder { text-align: center; padding: 2rem; color: var(--green-600); }
  .gallery-placeholder .ph-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .gallery-placeholder .ph-text { font-size: 0.85rem; font-weight: 500; }
  .gallery-placeholder .ph-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; }
  .gallery-caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: linear-gradient(to top, rgba(14,53,32,0.8), transparent);
    padding: 1rem; color: white; font-size: 0.85rem;
    transform: translateY(100%); transition: transform 0.3s;
  }
  .gallery-item:hover .gallery-caption { transform: translateY(0); }

  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: GALLERY LINK STYLES - Facebook layout links         */
  /* ═══════════════════════════════════════════════════════════ */
  .gallery-item-link {
    text-decoration: none;
    display: block;
    transition: transform 0.3s;
  }
  .gallery-item-link:hover {
    transform: translateY(-4px);
  }
  .gallery-item-link:hover .gallery-item {
    border-color: var(--green-400);
    box-shadow: 0 8px 24px rgba(30,107,63,0.15);
  }
  .gallery-item-link:hover .gallery-caption {
    background: linear-gradient(to top, rgba(24, 119, 242, 0.9), transparent);
  }
  /* ═══════════════════════════════════════════════════════════ */
  /* END GALLERY LINK STYLES                                        */
  /* ═══════════════════════════════════════════════════════════ */
  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: PHOTO GALLERY STYLES END HERE                      */
  /* ═══════════════════════════════════════════════════════════ */

  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: GOOGLE DRIVE VIDEO STYLES START HERE             */
  /* ═══════════════════════════════════════════════════════════ */
  .video-section {
    margin-top: 2rem; padding: 1.5rem;
    background: var(--green-50); border: 1px solid var(--green-200);
    border-radius: 16px;
  }
  .video-section-title {
    font-family: 'Playfair Display', serif; font-size: 1.1rem;
    color: var(--green-800); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
  .video-card {
    background: var(--white); border-radius: 16px; overflow: hidden;
    border: 1px solid var(--green-200); transition: all 0.3s;
  }
  .video-card:hover { box-shadow: 0 8px 24px rgba(30,107,63,0.12); transform: translateY(-4px); }
  .video-embed { position: relative; width: 100%; aspect-ratio: 16/9; background: var(--green-100); }
  .video-embed iframe { width: 100%; height: 100%; border: none; border-radius: 16px 16px 0 0; }
  .video-placeholder {
    width: 100%; height: 100%; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--green-100), var(--green-50));
    color: var(--green-700); gap: 0.5rem;
  }
  .video-placeholder .vid-icon { font-size: 2rem; }
  .video-placeholder .vid-text { font-size: 0.85rem; font-weight: 500; }
  .video-placeholder .vid-hint { font-size: 0.75rem; color: var(--text-muted); }
  .video-info { padding: 1rem 1.2rem; }
  .video-name { font-size: 0.95rem; font-weight: 500; color: var(--green-800); margin-bottom: 0.3rem; }
  .video-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; }
  .video-link-btn {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 0.8rem; padding: 0.5rem 1rem;
    background: var(--green-600); color: white; border-radius: 100px;
    font-size: 0.78rem; font-weight: 500; text-decoration: none;
    transition: all 0.2s;
  }
  .video-link-btn:hover { background: var(--green-700); transform: translateY(-1px); }
  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: GOOGLE DRIVE VIDEO STYLES END HERE                 */
  /* ═══════════════════════════════════════════════════════════ */

  .skills { background: var(--green-800); }
  .skills .section-label { color: var(--green-200); }
  .skills .section-title { color: var(--white); }
  .skills .section-divider { background: var(--green-400); }
  .skills-inner { max-width: 1100px; margin: 0 auto; }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
  .skill-card {
    background: rgba(255,255,255,0.06); border: 1px solid rgba(76,175,120,0.25);
    border-radius: 16px; padding: 1.5rem; transition: all 0.3s;
  }
  .skill-card:hover { background: rgba(76,175,120,0.12); border-color: var(--green-400); transform: translateY(-4px); }
  .skill-icon { font-size: 1.8rem; margin-bottom: 0.8rem; }
  .skill-name { font-size: 0.95rem; font-weight: 500; color: var(--white); margin-bottom: 0.4rem; }
  .skill-desc { font-size: 0.8rem; color: rgba(255,255,255,0.5); line-height: 1.6; }
  .skill-bar-wrap { margin-top: 0.8rem; height: 3px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }
  .skill-bar { height: 100%; background: var(--green-400); border-radius: 2px; width: 0; transition: width 1.2s ease; }

  .education { background: var(--white); }
  .edu-inner { max-width: 1100px; margin: 0 auto; }
  .edu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .edu-card {
    border: 1px solid var(--green-200); border-radius: 20px; padding: 2rem;
    position: relative; overflow: hidden; transition: all 0.3s;
  }
  .edu-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--green-400); }
  .edu-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(30,107,63,0.1); }
  .edu-level { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: var(--green-500); background: var(--green-100); padding: 4px 12px; border-radius: 100px; display: inline-block; margin-bottom: 1rem; }
  .edu-degree { font-size: 0.95rem; font-weight: 500; color: var(--green-800); margin-bottom: 0.3rem; }
  .edu-school { font-size: 0.88rem; color: var(--text-mid); margin-bottom: 0.5rem; }
  .edu-year { font-size: 0.78rem; color: var(--text-muted); }
  .edu-honors { margin-top: 0.8rem; font-size: 0.78rem; font-weight: 500; color: var(--gold); background: var(--gold-light); padding: 4px 12px; border-radius: 100px; display: inline-block; }

  .contact { background: linear-gradient(135deg, var(--green-700) 0%, var(--green-900) 100%); text-align: center; }
  .contact .section-label { color: var(--green-200); }
  .contact .section-title { color: var(--white); }
  .contact .section-divider { margin: 0 auto 2rem; }
  .contact-sub { font-size: 0.95rem; color: rgba(255,255,255,0.6); margin-bottom: 3rem; line-height: 1.7; }
  .contact-chips { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .contact-chip {
    display: flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(76,175,120,0.3);
    border-radius: 100px; padding: 0.75rem 1.5rem;
    font-size: 0.85rem; color: rgba(255,255,255,0.85);
    text-decoration: none; transition: all 0.2s;
  }
  .contact-chip:hover { background: rgba(76,175,120,0.2); border-color: var(--green-400); transform: translateY(-2px); }
  .contact-chip .chip-icon { font-size: 1rem; }

  /* ═══════════════════════════════════════════════════════════ */
  /* MARKER: CONTACT CHIP STYLES - Facebook & Gmail            */
  /* ═══════════════════════════════════════════════════════════ */
  .facebook-chip {
    background: linear-gradient(135deg, #1877f2, #166fe5) !important;
